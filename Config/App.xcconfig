PRODUCT_NAME = Persillade
PRODUCT_BUNDLE_IDENTIFIER = xyz.g1lom.persillade
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Persillade
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_NSRemindersFullAccessUsageDescription = Persillade utilise les rappels pour lire et mettre à jour votre liste de courses.
INFOPLIST_KEY_NSCameraUsageDescription = Persillade utilise l’appareil photo pour lire vos recettes sur papier.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
CODE_SIGN_ENTITLEMENTS = Persillade/Persillade.entitlements
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
